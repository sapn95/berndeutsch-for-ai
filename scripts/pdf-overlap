#!/usr/bin/env python3
"""pdf-overlap — measure what rules/schrybwys.md shares with the CC BY-ND PDF.

NOTICE makes claims about how much this repository's rulebook has in common
with Ursula Pinheiro-Weber's "Bärndütsch schrybe: schriftsprach-nach". Those
claims were written by hand three times and were wrong all three times: words
named as shared that were not in the document, a word count that drifted after
an edit, and a flat "no phrase appears in both" that four phrases contradicted.

So the claim is no longer written by hand. This script measures it, NOTICE
quotes the output, and anyone can re-run it:

    scripts/pdf-overlap                 # measure and print
    scripts/pdf-overlap --phrases 2     # shortest shared phrase length to report

Requires pdftotext (poppler). Without it the script says so and exits 3 rather
than guessing.
"""

import argparse
import ast
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
import urllib.request
from pathlib import Path

PDF_URL = ("https://www.berndeutsch.ch/doc/"
           "berndeutsch-schreiben-schriftsprach-nah-v1.pdf")
REPO = Path(__file__).resolve().parent.parent
RULEBOOK = REPO / "rules" / "schrybwys.md"
UA = "pdf-overlap/1.0 (+https://github.com/sapn95/berndeutsch-for-ai)"
MIN_WORD = 3


def pdf_text(cache):
    """Fetch the PDF once into `cache` and return its text."""
    pdf = cache / "schriftsprach-nah.pdf"
    if not pdf.exists():
        req = urllib.request.Request(PDF_URL, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=60) as resp:
            pdf.write_bytes(resp.read())
    tool = shutil.which("pdftotext")
    if not tool:
        print("pdftotext not found (brew install poppler / apt install poppler-utils).",
              file=sys.stderr)
        print("Refusing to guess at the overlap.", file=sys.stderr)
        raise SystemExit(3)
    out = cache / "pdf.txt"
    subprocess.run([tool, "-layout", str(pdf), str(out)], check=True,
                   capture_output=True)
    return out.read_text(encoding="utf-8")


def words(text):
    text = unicodedata.normalize("NFC", text)
    return [w.lower() for w in re.findall(r"[^\W\d_]+", text, re.UNICODE)]


MIN_EXAMPLES = 20
MIN_EMBEDDED = 200


def rules_text(path, source):
    """The rules content of a file, which for a .py file is not the file.

    The hook carries its rulebook as a string constant. Measuring the .py
    itself measured 943 words of English comments and Python identifiers, and
    duly reported a comfortable 6%: "verb", "form", "fall" and "hand" came out
    as shared vocabulary, none of which is an example of anything. A denominator
    made of the wrong text is not a small inaccuracy, it is the same
    hand-waving this script exists to replace.

    Parsed rather than imported: reading a claim out of a file must not run the
    file.
    """
    if path.suffix != ".py":
        return source, None
    picked = []
    for node in ast.parse(source).body:
        if not isinstance(node, ast.Assign) or not isinstance(node.value, ast.Constant):
            continue
        if not isinstance(node.value.value, str) or len(node.value.value) < MIN_EMBEDDED:
            continue
        for target in node.targets:
            if isinstance(target, ast.Name):
                picked.append((target.id, node.value.value))
    if not picked:
        print(f"note: {path.name} embeds no string constant of {MIN_EMBEDDED}+ "
              f"characters; measuring the source itself", file=sys.stderr)
        return source, None
    return "\n".join(v for _, v in picked), ", ".join(n for n, _ in picked)


def examples(rulebook):
    """The illustrative words.

    Normally everything in backticks. But the compact rulebook and the hook's
    embedded checklist barely use them, so on those files a backtick-only
    extraction measured almost nothing and reported a reassuring number that
    meant nothing. Below MIN_SPANS backticked spans, fall back to every word in
    the file and say so.
    """
    found = set()
    for span in re.findall(r"`([^`]+)`", rulebook):
        found.update(w for w in words(span) if len(w) >= MIN_WORD)
    # The test is on the RESULT, not on the number of spans. The compact
    # rulebook has plenty of backticks, but they wrap one- and two-letter
    # markers (`y`, `ds`, `ng`) that carry no example at all, so a span count
    # looked healthy while the extracted vocabulary was six words. Below
    # MIN_EXAMPLES, measure every word in the file and say so.
    if len(found) < MIN_EXAMPLES:
        print(f"note: only {len(found)} words inside backticks; measuring every "
              f"word of the text instead", file=sys.stderr)
        return {w for w in words(rulebook) if len(w) >= MIN_WORD}
    return found


def phrases(text, n):
    """Every n-word sequence, normalised, for a verbatim comparison."""
    seq = words(text)
    return {" ".join(seq[i:i + n]) for i in range(len(seq) - n + 1)}


# Words that only ever appear here as part of naming a source: the authors, the
# documents, the publishers, the licences. A sequence built entirely out of
# these is a citation, and a citation is not borrowed phrasing.
CITATION_WORDS = frozenset("""
marti werner bietenhard ruth greyerz otto von pinheiro weber ursula zingg hans
jürg dieth eugen francke cosmos bern auflage berndeutsches wörterbuch
bärndütschi schrybwys bärndütsch schrybe schriftsprach nach usschpraach naach
uussprach grammatik cc by nd sa spdx license identifier
""".split())


def classify(sequence):
    """Why a shared word sequence is shared. Reported, not asserted in prose.

    NOTICE used to state this partition in English and got it wrong every time
    the measurement moved: it claimed all sixteen non-"wi ne" matches were
    citations while three of them were not citations at all. A sentence that
    restates a machine's output is a sentence that will disagree with it later,
    so the machine states it.

    LETTERS catches the artefact that broke the claim. Both texts NAME single
    letters when they talk about spelling ("a soft `b`, `d` or `g`", "u + l"),
    and the word splitter drops the punctuation between them and hands back a
    pair. That is not shared phrasing, it is two texts discussing the same
    alphabet.
    """
    parts = sequence.split()
    if all(len(p) == 1 for p in parts):
        return "LETTERS"
    if all(p in CITATION_WORDS for p in parts):
        return "citation"
    return "OTHER"


def main():
    ap = argparse.ArgumentParser(prog="pdf-overlap", description=__doc__.splitlines()[0])
    ap.add_argument("--phrases", type=int, default=2,
                    help="shortest shared phrase length to report (default 2)")
    ap.add_argument("--cache", default=None, help="directory to keep the PDF in")
    ap.add_argument("--file", default=None,
                    help="check another file instead of rules/schrybwys.md "
                         "(the compact rulebook and the hook's embedded "
                         "checklist are copies of the same content and drift)")
    args = ap.parse_args()

    cache = Path(args.cache).expanduser() if args.cache else Path(tempfile.gettempdir()) / "bd-pdf-cache"
    cache.mkdir(parents=True, exist_ok=True)

    pdf = pdf_text(cache)
    target = Path(args.file).expanduser() if args.file else RULEBOOK
    book, embedded = rules_text(target, target.read_text(encoding="utf-8"))
    if embedded:
        print(f"note: measuring the embedded {embedded}, not the source file",
              file=sys.stderr)

    mine = examples(book)
    theirs = set(w for w in words(pdf) if len(w) >= MIN_WORD)
    shared = sorted(mine & theirs)
    pct = round(100 * len(shared) / len(mine)) if mine else 0

    try:
        label = target.relative_to(REPO)
    except ValueError:
        label = target
    if embedded:
        # Named in the printed line, not only on stderr, because NOTICE quotes
        # stdout and a quoted number has to say what it counted.
        label = f"{label} (embedded {embedded})"
    print(f"illustrative words in {label}: {len(mine)}")
    print(f"also occurring in the PDF:                   {len(shared)} ({pct}%)")
    print()
    print("shared:")
    for i in range(0, len(shared), 8):
        print("  " + ", ".join(shared[i:i + 8]))

    # Phrases are compared over the whole rulebook, not only its backticks: a
    # copied example sentence is prose, and prose is exactly what must not be
    # shared.
    print()
    worst = 0
    unexplained = []
    for n in range(args.phrases, 9):
        common = sorted(phrases(book, n) & phrases(pdf, n))
        if not common:
            break
        worst = n
        tally = {}
        for c in common:
            tally.setdefault(classify(c), []).append(c)
        summary = ", ".join(f"{len(v)} {k}" for k, v in sorted(tally.items()))
        print(f"shared {n}-word sequences: {len(common)}  ({summary})")
        for c in common[:20]:
            print(f"  {classify(c):9} {c}")
        if len(common) > 20:
            print(f"  ... and {len(common) - 20} more")
        unexplained += tally.get("OTHER", [])
    if worst == 0:
        print(f"no shared word sequence of length {args.phrases} or more")
    print()
    # The bottom line, computed rather than claimed. Anything not accounted for
    # as a citation or a named letter is phrasing that genuinely appears in both
    # texts, and that is the number a reader of NOTICE actually needs.
    if unexplained:
        print(f"sequences that are neither a citation nor named letters: "
              f"{len(unexplained)}")
        for c in unexplained:
            print(f"  {c}")
    else:
        print("every shared sequence is a citation or a pair of named letters")
    print()
    print("Note: short function-word sequences will always collide between two")
    print("texts about the same subject. What matters is whether a distinctive")
    print("example or a sentence of prose appears in both.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
